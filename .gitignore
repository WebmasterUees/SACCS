# Plugins/themes installed from wp.org (managed outside git by default)
app/public/wp-content/plugins/
app/public/wp-content/themes/

# Keep only custom code dirs if needed
!app/public/wp-content/plugins/
!app/public/wp-content/themes/
!app/public/wp-content/plugins/.gitkeep
!app/public/wp-content/themes/.gitkeep
!app/public/wp-content/mu-plugins/
